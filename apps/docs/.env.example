# Public URL of the docs site (used for metadata and the registry homepage).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Without the variables below, the demo uses an in-memory development storage.

# Amazon S3 (or any S3-compatible service via S3_ENDPOINT)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=

# Cloudflare R2 (takes precedence over S3 when set)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Secret for signing in-memory storage URLs. Set it when running more than one
# server instance; otherwise a random secret is generated per process.
UPLOAD_DEMO_SECRET=
