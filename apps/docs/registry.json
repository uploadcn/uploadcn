    {
      "name": "upload-route",
      "type": "registry:file",
      "title": "Upload Route (Next.js)",
      "description": "A Next.js route handler that signs S3 or R2 uploads at /api/upload.",
      "dependencies": ["@uploadcn/server@^0.1.0"],
      "envVars": {
        "S3_BUCKET": "",
        "S3_REGION": "",
        "S3_ACCESS_KEY_ID": "",
        "S3_SECRET_ACCESS_KEY": ""
      },
      "files": [
        {
          "path": "registry/default/files/upload-route.ts",
          "type": "registry:file",
          "target": "app/api/upload/route.ts"
        }
      ],
      "docs": "Fill in the S3_* (or R2_*) variables in .env.local, then allow PUT from your origin in the bucket's CORS settings and expose the ETag header (needed for multipart uploads). See https://uploadcn.dev/docs/adapters/s3 Optional virus scanning: set CLAMAV_HOST or VIRUSTOTAL_API_KEY. See https://uploadcn.dev/docs/guides/virus-scanning",
      "categories": ["upload", "server"]
    },
    {
      "name": "ocr-route",
      "type": "registry:file",
      "title": "OCR Route (Next.js)",
      "description": "A Next.js route handler at /api/ocr that reads text with Google Vision, Textract, Azure, Mistral or your own service.",
